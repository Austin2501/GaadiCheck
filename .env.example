# Copy to .env and fill in what you have. Every value is optional; the app falls back gracefully.

# Base URL that serves data/grap-status.json and data/rules.json.
# Point it at the raw GitHub URL of this repo's data folder so the stage can be updated without a new build.
EXPO_PUBLIC_DATA_BASE_URL=https://raw.githubusercontent.com/<github-user>/gaadicheck/main/data

# Free key from https://data.gov.in (used for official CPCB station AQI). Without it the app shows modelled estimates.
EXPO_PUBLIC_DATA_GOV_API_KEY=

# Optional product analytics (PostHog free tier). Leave empty to disable.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Only for building under a different Expo account; app.config.ts already holds the project's IDs.
EAS_OWNER=
EAS_PROJECT_ID=
